API_BASE=http://localhost:5000/api

# Video source: 0 for the laptop's own webcam, or the Pi's MJPEG stream URL
# (see pi_stream_server.py on the Pi), e.g. http://<pi-ip>:5001/stream.mjpg
CAMERA_SOURCE=0

# Pre-fill for quick testing — leave unset to be prompted instead
DROID_EMAIL=
DROID_PASSWORD=
